---
/* The index only exists in a built site, so dev says so rather than pretending:
   PagefindUI's fetch failure happens inside the bundle and cannot be caught by
   the caller. Test search with `npm run build && npm run preview`. */
const isProd = import.meta.env.PROD;
---

<button id="search-open" type="button" aria-label="Search" title="Search">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <circle cx="11" cy="11" r="6.5"></circle>
    <path d="M16 16l4.5 4.5"></path>
  </svg>
</button>

<dialog id="search-dialog" aria-label="Search this site" data-pagefind-ignore>
  <div class="shell">
    {
      isProd ? (
        <>
          <p class="status" data-search-status>Loading search…</p>
          <div class="ui" data-search-ui hidden>
            <pagefind-input></pagefind-input>
            <pagefind-summary></pagefind-summary>
            <pagefind-results></pagefind-results>
          </div>
        </>
      ) : (
        <p class="status">
          Search needs the Pagefind index, which only a build produces. Run
          <code>npm run build &amp;&amp; npm run preview</code>.
        </p>
      )
    }
  </div>
</dialog>

<script>
  import '../../scripts/search';
</script>

<style>
  #search-open {
    background: none;
    border: 0;
    color: var(--color-ink-light);
    cursor: pointer;
    display: inline-flex;
    padding: 0;
    transition: color var(--dur-fast) var(--ease-out);
  }

  #search-open:hover {
    color: var(--color-ink-deep);
  }

  dialog {
    background-color: var(--color-paper);
    border: 1px solid var(--color-chip);
    border-radius: var(--radius-chip);
    color: var(--color-ink);
    margin-inline: auto;
    margin-top: 12vh;
    max-height: 70vh;
    max-width: min(38rem, calc(100vw - 2rem));
    padding: 0;
    width: 100%;

    /* Pagefind's own dark rules key off [data-pf-theme]; defining the tokens on
       the dialog keeps site theme and OS theme independent. */
    --pf-font: var(--font-body);
    --pf-background: var(--color-paper);
    --pf-border: var(--color-chip);
    --pf-border-focus: var(--color-focus);
    --pf-border-radius: var(--radius-chip);
    --pf-hover: var(--color-chip);
    --pf-mark: var(--color-ink-max);
    --pf-outline-focus: var(--color-focus);
    --pf-skeleton: var(--color-chip);
    --pf-modal-backdrop: transparent;
    --pf-shadow-sm: none;
    --pf-shadow-md: none;
    --pf-shadow-lg: none;
  }

  dialog::backdrop {
    background-color: rgb(0 0 0 / 0.4);
  }

  .shell {
    padding: 1rem;
  }

  .status {
    color: var(--color-ink-light);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
  }

  .status code {
    font-size: 0.8125rem;
  }

  .ui {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
</style>

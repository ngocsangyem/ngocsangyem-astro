---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { name, description, url, icon } = project.data;
const Tag = url ? 'a' : 'div';
---

{
  /* A ruled row: small greyscale icon, name, one-sentence description. The
     row is the link; an external one ends in ↗. Hover is a row fill, never
     a colour pop or movement. */
}
<Tag class="item" href={url} rel={url ? 'noopener' : undefined}>
  {icon && <img class="icon" src={`/icons/${icon}`} alt="" width="20" height="20" />}
  <span class="text">
    <span class="name">
      {name}
      {url && <span class="ext" aria-hidden="true">↗</span>}
    </span>
    <span class="description">{description}</span>
  </span>
</Tag>

<style>
  .item {
    align-items: flex-start;
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-2);
    text-decoration: none;
  }

  a.item:hover {
    background-color: var(--color-hover-row);
  }

  .icon {
    filter: grayscale(1);
    flex: none;
    margin-block-start: 0.15rem;
  }

  .text {
    display: grid;
    gap: var(--space-1);
  }

  .name {
    color: var(--color-ink);
    font-size: var(--text-ui);
    font-weight: 500;
  }

  .ext {
    color: var(--color-ink-3);
    font-size: 0.8em;
    margin-inline-start: 0.25em;
  }

  .description {
    color: var(--color-ink-3);
    font-size: var(--text-label);
    line-height: 1.5;
  }
</style>

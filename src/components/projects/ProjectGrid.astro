---
import type { CollectionEntry } from 'astro:content';
import ProjectItem from './ProjectItem.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

const byCategory = new Map<string, CollectionEntry<'projects'>[]>();
for (const project of projects) {
  const bucket = byCategory.get(project.data.category);
  if (bucket) bucket.push(project);
  else byCategory.set(project.data.category, [project]);
}
const categories = [...byCategory.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<div class="categories">
  {categories.map(([category, items]) => (
    <section>
      <h2 class="category">{category}</h2>
      <div class="grid">
        {items.map((project) => <ProjectItem project={project} />)}
      </div>
    </section>
  ))}
</div>

<style>
  .categories {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .category {
    color: var(--color-ink-light);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    margin-block-end: var(--space-2);
    text-transform: uppercase;
  }

  .grid {
    display: grid;
    gap: var(--space-2) var(--space-6);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
</style>

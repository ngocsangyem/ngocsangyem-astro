---
import type { CollectionEntry } from 'astro:content';
import ProjectItem from './ProjectItem.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

// Ordered by `order`, then grouped. A Map keeps insertion order, so a category
// takes its place from the highest-ranked project in it and the projects inside
// keep that same ranking. Sorting the category names alphabetically instead
// would hand the top slot to whichever heading starts with an early letter,
// which is an accident rather than a decision.
const ranked = [...projects].sort((a, b) => a.data.order - b.data.order);

const byCategory = new Map<string, CollectionEntry<'projects'>[]>();
for (const project of ranked) {
  const bucket = byCategory.get(project.data.category);
  if (bucket) bucket.push(project);
  else byCategory.set(project.data.category, [project]);
}
const categories = [...byCategory.entries()];
---

<div class="categories">
  {categories.map(([category, items]) => (
    <section>
      <h2 class="mono-label category">
        {category} <span class="num">{items.length}<span class="visually-hidden"> {items.length === 1 ? 'project' : 'projects'}</span></span>
      </h2>
      <ul class="rows" role="list">
        {items.map((project) => <li><ProjectItem project={project} /></li>)}
      </ul>
    </section>
  ))}
</div>

<style>
  .categories {
    display: grid;
    gap: var(--space-8);
  }

  .category {
    color: var(--color-ink);
    margin-block-end: var(--space-2);
  }

  .category .num {
    color: var(--color-ink-3);
    margin-inline-start: var(--space-2);
  }

  .rows {
    border-block-start: var(--border-hairline) solid var(--color-line);
    margin: 0;
  }

  .rows > li {
    border-block-end: var(--border-hairline) solid var(--color-line-soft);
  }
</style>

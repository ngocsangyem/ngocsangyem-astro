---
import { PORTFOLIO_EXPERIENCE } from "../../data/portfolio-experience";
import CareerRouteGraphic from "./CareerRouteGraphic.astro";
import CareerTimeline from "./CareerTimeline.astro";
---

<section id="experience" class="experience" aria-labelledby="experience-title">
  <header class="section-head" data-enter>
    <div>
      <p class="label">Career path</p>
      <h2 id="experience-title">Seven years, three stops.</h2>
    </div>
    <p class="summary">
      I started in frontend in 2019. Today I work as a Software Engineer at
      Aspire.
    </p>
  </header>

  <div class="career-track">
    <CareerRouteGraphic />
    <CareerTimeline items={PORTFOLIO_EXPERIENCE} />
  </div>
</section>

<style>
  .experience {
    border-block-start: var(--border-hairline) solid
      color-mix(in srgb, var(--color-ink-light) 35%, transparent);
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .section-head {
    align-items: end;
    display: grid;
    gap: var(--space-8);
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.7fr);
    margin-block-end: clamp(8rem, 14vw, 11rem);
  }

  .label {
    color: var(--color-ink-light);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    margin-block-end: var(--space-4);
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(2.75rem, 6vw, 5.75rem);
    letter-spacing: -0.065em;
    line-height: 0.9;
    max-inline-size: 9ch;
  }

  .summary {
    line-height: 1.65;
    max-inline-size: 38ch;
    text-wrap: pretty;
  }

  .career-track {
    --entry-indent: 9rem;
    --rail-x: 6.5rem;
    margin-inline: auto;
    max-inline-size: 52rem;
    position: relative;
  }

  @media (max-width: 48rem) {
    .section-head {
      align-items: start;
      grid-template-columns: 1fr;
      margin-block-end: 10rem;
    }

    .career-track {
      --entry-indent: 2rem;
      --rail-x: 0.25rem;
    }
  }
</style>

---
import { RESUME, SITE } from '../../config/site';
---

<section class="hero" aria-labelledby="portfolio-title">
  <div class="eyebrow" data-enter>
    <p>Software Engineer</p>
    <p>Based in Vietnam</p>
  </div>

  <h1 id="portfolio-title" aria-label={SITE.author}>
    <span data-enter style="--enter-stage: 1">Sang</span>
    <span data-enter style="--enter-stage: 2">Nguyen</span>
  </h1>

  <div class="intro-row" data-enter style="--enter-stage: 3">
    <p>
      I’m a Software Engineer at Aspire with 7+ years building enterprise web
      applications in TypeScript, React, Vue.js and PHP. I build interfaces that
      feel simple to use and stay sensible to maintain.
    </p>
    <div class="actions">
      <a
        class="resume"
        href={RESUME.href}
        download={RESUME.filename}
        type="application/pdf"
      >
        <span class="resume-glyph" aria-hidden="true">↓</span>
        Download résumé
        <span class="resume-meta">PDF · {RESUME.size}</span>
      </a>
      <a href="#experience">Follow the path <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-block-size: min(48rem, calc(100svh - 7rem));
    padding-block: clamp(3rem, 9vw, 7.5rem) var(--space-10);
  }

  .eyebrow,
  .intro-row {
    align-items: flex-start;
    display: flex;
    justify-content: space-between;
  }

  .eyebrow {
    color: var(--color-ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(5rem, 15vw, 12.75rem);
    font-weight: 500;
    letter-spacing: -0.095em;
    line-height: 0.68;
    margin-block: clamp(5rem, 12vw, 9rem);
  }

  h1 span {
    display: block;
  }

  h1 span:last-child {
    color: var(--color-ink-3);
    margin-inline-start: 0.7em;
  }

  .intro-row {
    align-items: end;
    border-block-start: var(--border-hairline) solid var(--color-line);
    gap: var(--space-8);
    padding-block-start: var(--space-5);
  }

  .intro-row p {
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    line-height: 1.55;
    max-inline-size: 47ch;
    text-wrap: pretty;
  }

  .actions {
    align-items: flex-end;
    display: flex;
    flex: none;
    flex-direction: column;
    gap: var(--space-4);
  }

  .actions a {
    color: var(--color-ink-3);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  /* Square-cornered mono label, per the CTA voice: no pill, hover is a colour
     step plus the row fill, never a lift. */
  .actions .resume {
    align-items: baseline;
    border: var(--border-hairline) solid var(--color-line);
    color: var(--color-ink);
    display: inline-flex;
    font-size: 0.75rem;
    gap: var(--space-2);
    letter-spacing: 0.04em;
    padding: 0.65rem 0.9rem;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color var(--motion-fast) ease-out,
      border-color var(--motion-fast) ease-out,
      color var(--motion-fast) ease-out;
  }

  .resume-glyph {
    color: var(--color-accent);
  }

  .resume-meta {
    color: var(--color-ink-3);
    letter-spacing: 0.02em;
    margin-inline-start: var(--space-2);
    text-transform: none;
  }

  .actions .resume:hover {
    background-color: var(--color-hover-row);
    border-color: var(--color-ink-3);
    color: var(--color-accent-text);
  }

  .actions .resume:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  @media (max-width: 42rem) {
    .hero {
      min-block-size: auto;
      padding-block-start: var(--space-10);
    }

    .eyebrow,
    .intro-row {
      flex-direction: column;
    }

    .eyebrow {
      gap: var(--space-2);
    }

    h1 {
      font-size: clamp(3.5rem, 17vw, 6rem);
      line-height: 0.74;
      margin-block: var(--space-10);
    }

    h1 span:last-child {
      margin-inline-start: 0.08em;
    }

    .intro-row {
      align-items: stretch;
      gap: var(--space-6);
    }

    .intro-row p {
      max-inline-size: none;
      inline-size: 100%;
    }

    .actions {
      align-items: flex-start;
    }
  }
</style>

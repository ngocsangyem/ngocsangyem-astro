---
/* Luỹ tre as line art — the ambient bamboo sketch behind the page.
 *
 * Two fixed, pointer-inert canvases stacked at the very back. The near one
 * carries crisp pen strokes; the far one carries the same grove restated as
 * wide soft strokes and is blurred in CSS, so the hedge has real depth without
 * a second colour or a second drawing pass. Geometry comes from
 * src/lib/bamboo-lines.ts.
 *
 * On page load the culms rise out of their own feet for under two seconds, then
 * both canvases freeze — one final paint, no running loop, no idle CPU or GPU
 * cost. The reading column above wears frosted glass (.page-glass), so bamboo
 * passing under the text blurs into depth while the culms beside it stay sharp.
 *
 * The ink comes from each canvas's own `color`, so the theme owns it: soft sage
 * on paper, pale moss on near-black. Flipping data-theme repaints the settled
 * frame in the new ink; resizing regrows the geometry for the new viewport and
 * paints it settled, never replaying the entrance.
 *
 * The layer is decorative in the strict sense — aria-hidden and inert to the
 * pointer — and with reduced motion the grove is simply already grown.
 */
import { HAZE_PAD } from '../../lib/bamboo-lines';
---

<div class="bamboo" aria-hidden="true">
  <canvas class="bamboo-haze"></canvas>
  <canvas class="bamboo-ink"></canvas>
</div>

<script>
  import { generateGrove, drawPlane, HAZE_PAD, SETTLE_MS } from '../../lib/bamboo-lines';

  /* A fixed seed keeps the artwork identical on every visit at a given
     viewport, so the grove never surprises a returning reader. */
  const SEED = 0x6c7579;

  const haze = document.querySelector<HTMLCanvasElement>('canvas.bamboo-haze');
  const ink = document.querySelector<HTMLCanvasElement>('canvas.bamboo-ink');
  const hazeCtx = haze?.getContext('2d');
  const inkCtx = ink?.getContext('2d');

  if (haze && ink && hazeCtx && inkCtx) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let grove = generateGrove({ seed: SEED, width: 0, height: 0 });
    let settled = false;
    let raf = 0;

    /* The frame the canvases are currently cut for. Comparing against it makes
       re-fitting idempotent, so every source of a size change can call the same
       handler without a first-run guard. */
    let fittedW = 0;
    let fittedH = 0;
    let fittedDpr = 0;

    /* The theme's two inks, read once per settle rather than once per frame:
       getComputedStyle inside the loop is a forced style flush 60 times a
       second for a value that changes twice a visit. */
    let inkColor = '';
    let hazeColor = '';

    function readInks(): void {
      hazeColor = getComputedStyle(haze!).color;
      inkColor = getComputedStyle(ink!).color;
    }

    /** Match a backing store to its CSS size × devicePixelRatio (retina-crisp)
     *  and place the origin so the grove's floor lands on the frame's, whatever
     *  the overhang and whatever the height has done since it was grown. */
    function fit(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D, pad: number): void {
      canvas.width = Math.round((fittedW + pad * 2) * fittedDpr);
      canvas.height = Math.round((fittedH + pad * 2) * fittedDpr);
      const floor = fittedH - grove.height;
      ctx.setTransform(fittedDpr, 0, 0, fittedDpr, pad * fittedDpr, (pad + floor) * fittedDpr);
    }

    /** True when the viewport or the pixel ratio has moved off what the
     *  canvases were last cut for. */
    function stale(): boolean {
      return (
        window.innerWidth !== fittedW ||
        window.innerHeight !== fittedH ||
        (window.devicePixelRatio || 1) !== fittedDpr
      );
    }

    /** Re-cut the canvases for the current frame, regrowing the geometry only
     *  when the frame has really changed shape: any change of width, or a
     *  change of height too large to be browser chrome coming and going.
     *
     *  The frame the geometry was grown for is a different thing from the frame
     *  the canvases are cut for, and the grove records its own. A phone's
     *  address bar sliding away changes the height on every scroll; a grove
     *  regrown each time would reshuffle itself under the reader's thumb. So
     *  the drawing stays and only the canvases move, anchored at the floor —
     *  the grove keeps its feet on the ground and the top of the frame reveals
     *  or hides a little more of it, which is what a taller window should do. */
    function fitAll(): void {
      fittedW = window.innerWidth;
      fittedH = window.innerHeight;
      fittedDpr = window.devicePixelRatio || 1;

      if (fittedW !== grove.width || Math.abs(fittedH - grove.height) > grove.height * 0.25) {
        grove = generateGrove({ seed: SEED, width: fittedW, height: fittedH });
      }

      fit(haze!, hazeCtx!, HAZE_PAD);
      fit(ink!, inkCtx!, 0);
      readInks();
    }

    function paint(t: number): void {
      drawPlane(hazeCtx!, grove.haze, t, hazeColor);
      drawPlane(inkCtx!, grove.ink, t, inkColor);
    }

    function grow(): void {
      const start = performance.now();
      const frame = (now: number) => {
        const t = Math.min(1, (now - start) / SETTLE_MS);
        paint(t);
        if (t < 1) {
          raf = requestAnimationFrame(frame);
        } else {
          settled = true;
        }
      };
      raf = requestAnimationFrame(frame);
    }

    fitAll();

    if (reducedMotion) {
      settled = true;
      paint(1);
    } else {
      grow();
    }

    /* Theme flips repaint the settled frame in the new ink. Mid-entrance the
       running loop picks the new colour up on its next frame by itself. */
    new MutationObserver(() => {
      readInks();
      if (settled) paint(1);
    }).observe(document.documentElement, { attributeFilter: ['data-theme'] });

    /* A new frame re-cuts the canvases, already settled. A resize mid-entrance
       cuts the show short — a window being dragged has the reader's attention
       anyway.

       Watched two ways because the viewport changes in more ways than one: a
       ResizeObserver on the layer catches everything that alters its box,
       including a mobile browser's chrome sliding away and a scrollbar
       appearing, neither of which need be a window resize; the window listener
       catches a move to a display of a different pixel ratio, which changes no
       box at all. Both funnel through one debounce, and `stale()` throws away
       the calls that turn out to be nothing. */
    let debounce = 0;
    function regrow(): void {
      clearTimeout(debounce);
      debounce = window.setTimeout(() => {
        if (!stale()) return;
        cancelAnimationFrame(raf);
        settled = true;
        fitAll();
        paint(1);
      }, 150);
    }

    new ResizeObserver(regrow).observe(document.querySelector('.bamboo')!);
    window.addEventListener('resize', regrow);
  }
</script>

<style define:vars={{ hazePad: `${HAZE_PAD}px` }}>
  .bamboo {
    /* Behind the page. Paper lives on `html` so this still reads through.
       The clip is what lets the soft plane overhang: its blur is computed from
       geometry that runs past every edge, and the overhang is cropped away. */
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  .bamboo canvas {
    position: absolute;
  }

  .bamboo-ink {
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--grove-ink);
  }

  /* The out-of-focus plane. Blurring the canvas in CSS costs one compositor
     pass and keeps the geometry — and the growth — identical to the near one. */
  .bamboo-haze {
    inset: calc(-1 * var(--hazePad));
    width: calc(100% + 2 * var(--hazePad));
    height: calc(100% + 2 * var(--hazePad));
    color: var(--grove-haze);
    filter: blur(var(--grove-haze-blur));
  }
</style>

---
/* Placeholder handwriting until the author supplies their own. The contract is
   the slot and the draw-in, so swapping the path needs no other change:
   pathLength="1" means the dash maths never has to be re-measured. */
---

<svg
  class="mark"
  viewBox="0 0 104 44"
  width="72"
  height="30"
  role="img"
  aria-label="Sang"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path
    class="draw-path"
    pathLength="1"
    d="M20 12C17 8 10 9 9 14c-1 5 9 6 10 11 1 4-5 6-9 3
       M30 22c-4-2-8 1-8 6 0 4 4 6 7 3 3-2 4-7 3-9 1 3 0 7 1 9 1 2 3 2 4 1
       M44 31V22c3-3 8-2 8 3v6
       M70 21c-4-2-8 1-8 6 0 4 4 6 7 3 3-2 4-7 3-9 0 5-1 12 0 16 0 5-6 6-9 3"
  />
</svg>

<style>
  .mark {
    color: var(--color-ink-deep);
    display: block;
  }

  /* Only the first page of a visit animates; the flag is set before paint. */
  html:not([data-mark-drawn]) .draw-path {
    stroke-dasharray: 1;
    animation: draw-in 1200ms var(--ease-out) both;
  }

  @media (prefers-reduced-motion: reduce) {
    html:not([data-mark-drawn]) .draw-path {
      animation: fade-enter var(--dur-fast) var(--ease-out) both;
      stroke-dasharray: none;
    }
  }
</style>

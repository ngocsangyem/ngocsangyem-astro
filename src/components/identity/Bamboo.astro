---
/* Ambient ornament for the left page margin. Ink only, no colour, and it never
   enters the reading column. Static in v1; a generative variation set is
   deferred. */
---

<div class="bamboo" aria-hidden="true">
  <svg viewBox="0 0 90 420" fill="none" stroke="currentColor" stroke-linecap="round">
    <!-- culm -->
    <path d="M46 420C40 350 52 300 44 236C38 186 50 140 42 86C38 58 44 30 40 4"
          stroke-width="2.2" />
    <!-- nodes -->
    <path d="M39 236h11M41 156h11M37 86h11M39 316h11" stroke-width="1.6" />
    <!-- branches -->
    <path d="M45 232C58 224 66 210 70 194M43 152C30 146 22 132 19 116M41 84C54 78 63 66 67 52"
          stroke-width="1.3" />
    <!-- leaves -->
    <path d="M70 194c6-9 8-19 6-27-8 2-14 9-17 18-1 4 0 8 2 10 3 1 7-1 9-1Z" stroke-width="1.2" />
    <path d="M63 205c9-3 17-9 21-16-8-3-17-1-24 5-3 3-4 7-3 9 1 2 4 2 6 2Z" stroke-width="1.2" />
    <path d="M19 116c-7-7-11-16-11-25 8 0 15 6 19 15 2 4 2 8 0 10-2 1-6 0-8 0Z" stroke-width="1.2" />
    <path d="M26 128c-9-1-18-6-23-12 7-4 16-4 24 1 4 2 6 6 5 8-1 2-4 3-6 3Z" stroke-width="1.2" />
    <path d="M67 52c5-9 7-20 5-28-8 2-14 10-16 19-1 4 0 8 2 9 3 2 7 0 9 0Z" stroke-width="1.2" />
  </svg>
</div>

<style>
  .bamboo {
    display: none;
  }

  /* Only once the margin is genuinely wider than the ornament. */
  @media (min-width: 100rem) {
    .bamboo {
      color: var(--color-ink-light);
      display: block;
      left: 2.5rem;
      opacity: 0.18;
      pointer-events: none;
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      user-select: none;
      width: 5.5rem;
      z-index: 0;
    }
  }
</style>

---
/* Luỹ tre — the ambient bamboo hedge behind the page.
 *
 * Geometry comes from src/lib/grove.ts at build time, so this ships as plain
 * markup: no client script, no measurement, no layout shift. The layer is
 * decorative in the strict sense — aria-hidden, inert to the pointer, and
 * masked out of the reading column, so it can never sit under running text.
 *
 * Two groves rather than one mirrored copy: a mirror image is legible as a
 * mirror image. The right-hand grove is generated from its own seed and simply
 * rendered through a horizontal flip so both lean in over the reader.
 */
import { generateGrove, planeStroke, type Grove } from '../../lib/grove';

/* Fixed seeds keep the artwork identical on every build, so it caches and never
   surprises a returning reader. */
const left = generateGrove({ seed: 0x6c7579, density: [7, 5, 3] });
const right = generateGrove({ seed: 0x747265, density: [5, 4, 2] });

/* The sway may only begin once a culm has finished drawing, or it would appear
   to bend before it exists. */
const groves: { grove: Grove; side: 'left' | 'right' }[] = [
  { grove: left, side: 'left' },
  { grove: right, side: 'right' },
];
---

<div class="grove" aria-hidden="true">
  {groves.map(({ grove, side }) => (
    <svg
      class:list={['grove-svg', `grove-${side}`]}
      viewBox={`0 0 ${grove.width} ${grove.height}`}
      preserveAspectRatio="xMinYMax slice"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      {/* Stroke widths come from the plane class rather than an attribute per
          path: the same three values repeated across every path is pure
          payload, and the grove is inlined into each page that shows it. */}
      {grove.culms.map((culm) => (
        <g
          class:list={['culm', `plane-${culm.plane}`]}
          style={`transform-origin:${culm.originX}px ${culm.originY}px;--amp:${culm.amp}deg;--period:${culm.period}s;--sway-delay:${culm.swayDelay}s`}
        >
          <path
            class="culm-line"
            d={culm.d}
            pathLength="1"
            style={`--draw-delay:${culm.drawDelay}s;--draw-dur:${culm.drawDur}s`}
          />
          {culm.nodes && (
            <path
              class="culm-nodes"
              d={culm.nodes}
              style={`--fade-delay:${culm.nodeDelay}s;--fade-dur:${culm.nodeDur}s`}
            />
          )}
          {culm.fans.map((fan) => (
            <g class="fan" style={`--fade-delay:${fan.delay}s`}>
              {/* Nested so the leaf lag animates transform while the parent
                  animates opacity — one property each, no contention. */}
              <g class="fan-lag" style={`--lag-period:${culm.lagPeriod}s`}>
                <path class="leaf" d={fan.d} />
              </g>
            </g>
          ))}
        </g>
      ))}
    </svg>
  ))}
</div>

<style define:vars={{ sw0: planeStroke(0), sw1: planeStroke(1), sw2: planeStroke(2) }}>
  .grove {
    display: none;
  }

  /* Below this the margins cannot hold a grove without crowding the column. */
  @media (min-width: 64rem) {
    .grove {
      /* Behind the page. Paper lives on `html` so this still reads through. */
      position: fixed;
      inset: 0;
      z-index: -1;
      overflow: hidden;
      pointer-events: none;
      user-select: none;
      color: var(--color-ink-light);
      display: block;

      /* Punch the reading column out of the art. A gradient rather than a clip:
         the grove should thin into the margin like haze, not stop at a line.
         The band is derived from the measure, so it tracks the column at every
         width instead of guessing at breakpoints. */
      --edge: calc(50% - var(--grove-clear) / 2);
      mask-image: linear-gradient(
        to right,
        #000 0,
        #000 calc(var(--edge) - var(--grove-falloff)),
        transparent var(--edge),
        transparent calc(100% - var(--edge)),
        #000 calc(100% - var(--edge) + var(--grove-falloff)),
        #000 100%
      );
    }
  }

  .grove-svg {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--grove-width);
    height: 100%;
    max-width: none;
    opacity: var(--grove-opacity);
  }

  .grove-left {
    left: 0;
  }

  /* Same geometry, flipped, so this grove also leans in over the reader. */
  .grove-right {
    right: 0;
    transform: scaleX(-1);
  }

  .culm {
    /* Rotate about the culm's own base, in viewBox units. */
    transform-box: view-box;
    animation: grove-sway var(--period) var(--ease-in-out) var(--sway-delay) infinite both;
  }

  /* Stroke thickens toward the front, which is what makes the planes read as
     depth rather than as one flat thicket. The width travels as a custom
     property so the rings and blades can be derived from it: stroke-width
     itself cannot be multiplied, and its percentages resolve against the
     viewport rather than the parent. */
  .plane-0 {
    --sw: var(--sw0);
    /* The back plane hangs further off in the haze. */
    opacity: calc(var(--grove-opacity-back) / var(--grove-opacity));
  }

  .plane-1 {
    --sw: var(--sw1);
  }

  .plane-2 {
    --sw: var(--sw2);
  }

  .culm-line {
    stroke-width: var(--sw);
    /* pathLength is 1, so the offset is a fraction and survives any redraw of
       the artwork. Authored base to tip, so the culm rises out of the ground. */
    stroke-dasharray: 1;
    animation: grove-rise var(--draw-dur) var(--ease-out) var(--draw-delay) both;
  }

  /* Rings and blades sit a touch lighter than the culm carrying them. */
  .culm-nodes {
    stroke-width: calc(var(--sw) * 0.85);
  }

  .leaf {
    stroke-width: calc(var(--sw) * 0.7);
  }

  .culm-nodes,
  .fan {
    animation: grove-settle var(--fade-dur, 700ms) var(--ease-out) var(--fade-delay) both;
  }

  /* Leaves lag the culm they hang on. Without the lag the grove rocks like one
     rigid object; with it, the wind reads as passing through. */
  .fan-lag {
    transform-box: fill-box;
    transform-origin: 50% 0;
    animation: fan-lag var(--lag-period) var(--ease-in-out) infinite both;
  }

  @keyframes grove-rise {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes grove-settle {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Centred on zero at both ends, so a culm neither pops on the first frame nor
     jumps on the loop seam. */
  @keyframes grove-sway {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(var(--amp));
    }
    75% {
      transform: rotate(calc(var(--amp) * -1));
    }
  }

  @keyframes fan-lag {
    0%,
    100% {
      transform: rotate(0deg);
    }
    30% {
      transform: rotate(1.1deg);
    }
    70% {
      transform: rotate(-1.1deg);
    }
  }

  /* The grove is atmosphere, not information: with reduced motion it is simply
     already there. No draw, no sway. */
  @media (prefers-reduced-motion: reduce) {
    .culm,
    .fan-lag {
      animation: none;
    }

    .culm-line {
      animation: none;
      stroke-dashoffset: 0;
    }

    .culm-nodes,
    .fan {
      animation-name: grove-settle;
      animation-duration: var(--dur-fast);
      animation-delay: 0s;
    }
  }
</style>

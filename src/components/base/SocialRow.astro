---
import { SITE, type SocialIconName } from '../../config/site';

interface Props {
  /**
   * `row` is the site-wide footer line, prose voice and no glyphs.
   * `chips` is the compact identity block the home page sets under its title:
   * the same links in the chrome register, each carrying its brand mark.
   */
  variant?: 'row' | 'chips';
}

const { variant = 'row' } = Astro.props;

/**
 * Brand marks, inline rather than files under `public/favicons/`. That directory
 * is the rehype chip plugin's lookup table, so a file there would silently turn
 * every GitHub link in every post into a chip as well.
 *
 * Inline also means `currentColor`: GitHub's mark is monochrome by design, and
 * as an <img> it would stay black through the dark theme. Paths are simple-icons
 * (CC0-1.0), so both are the real marks rather than something drawn by hand.
 */
const ICON_PATHS: Record<SocialIconName, string> = {
  github:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
};

/* A chip with no mark would read as a broken image, so only the ones with a
   glyph can appear as chips. */
const chips = SITE.socials.filter((social) => social.icon);
---

{
  variant === 'chips' ? (
    <section class="socials socials-chips" aria-label="Contact" data-pagefind-ignore>
      <ul class="chip-list">
        {chips.map((social) => (
          <li>
            <a class="link-chip" href={social.href} rel="me noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d={ICON_PATHS[social.icon!]} />
              </svg>
              <span>{social.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ) : (
    <section class="socials page" aria-label="Contact" data-pagefind-ignore>
      <p>
        Find me on{' '}
        {SITE.socials.map((social, index) => (
          <>
            {index > 0 && <span aria-hidden="true"> · </span>}
            <a href={social.href} rel="me noopener">{social.label}</a>
          </>
        ))}
      </p>
      {SITE.email && <p class="email">{SITE.email}</p>}
    </section>
  )
}

<style>
  .socials {
    color: var(--color-ink-light);
  }

  .socials.page {
    margin-block: var(--space-10) var(--space-8);
  }

  .socials p {
    font-size: 0.9375rem;
  }

  .socials .email {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin-block-start: var(--space-2);
  }

  /* Sits directly under the page title, so the gap above is the title's own
     rhythm and only the space below it needs setting. */
  .socials-chips {
    margin-block: 0.875rem 0;
  }

  .chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The chip carries its own fill, so it stays ink rather than taking the link
     colour and underline. */
  .chip-list .link-chip {
    color: var(--color-ink);
    font-size: 0.875rem;
  }
</style>

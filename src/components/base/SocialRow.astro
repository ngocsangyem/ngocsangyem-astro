---
import { Icon } from 'astro-icon/components';
import { SITE } from '../../config/site';

interface Props {
  /**
   * `row` is the site-wide footer line, prose voice and no glyphs.
   * `chips` is the compact identity block the home page sets under its title:
   * the same links in the chrome register, each carrying its brand mark.
   */
  variant?: 'row' | 'chips';
}

const { variant = 'row' } = Astro.props;

/* Brand marks come from astro-icon's simple-icons set — the same CC0 paths the
 * component used to inline by hand — rather than files under `public/favicons/`.
 * That directory is the rehype chip plugin's lookup table, so a file there
 * would silently turn every GitHub link in every post into a chip as well.
 * Inlined SVG also means `currentColor`: GitHub's mark is monochrome by design,
 * and as an <img> it would stay black through the dark theme.
 *
 * A chip with no mark would read as a broken image, so only the ones with a
 * glyph can appear as chips. */
const chips = SITE.socials.filter((social) => social.icon);
---

{
  variant === 'chips' ? (
    <section class="socials socials-chips" aria-label="Contact" data-pagefind-ignore>
      <ul class="chip-list">
        {chips.map((social) => (
          <li>
            <a class="link-chip" href={social.href} rel="me noopener">
              <Icon name={`simple-icons:${social.icon}`} aria-hidden="true" />
              <span>{social.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ) : (
    <section class="socials page" aria-label="Contact" data-pagefind-ignore>
      <p>
        Find me on{' '}
        {SITE.socials.map((social, index) => (
          <>
            {index > 0 && <span aria-hidden="true"> · </span>}
            <a href={social.href} rel="me noopener">{social.label}</a>
          </>
        ))}
      </p>
      {SITE.email && <p class="email">{SITE.email}</p>}
    </section>
  )
}

<style>
  .socials {
    color: var(--color-ink-light);
  }

  .socials.page {
    margin-block: var(--space-10) var(--space-8);
  }

  .socials p {
    font-size: 0.9375rem;
  }

  .socials .email {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin-block-start: var(--space-2);
  }

  /* Sits directly under the page title, so the gap above is the title's own
     rhythm and only the space below it needs setting. */
  .socials-chips {
    margin-block: 0.875rem 0;
  }

  .chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The chip carries its own fill, so it stays ink rather than taking the link
     colour and underline. */
  .chip-list .link-chip {
    color: var(--color-ink);
    font-size: 0.875rem;
  }
</style>

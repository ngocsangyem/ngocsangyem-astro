---
import { Icon } from 'astro-icon/components';
import { parentPath } from '../../lib/routes';

const target = parentPath(Astro.url.pathname);
const label = target === '/' ? 'cd .. (back to the home page)' : `cd .. (back to ${target})`;
---

{
  target && (
    <div class="cd-up page" data-pagefind-ignore>
      <a href={target} aria-label={label}>
        <Icon name="lucide:chevron-right" size={14} aria-hidden="true" />
        <span>cd ..</span>
      </a>
    </div>
  )
}

<style>
  .cd-up {
    margin-block: 4rem 0;
  }

  a {
    align-items: center;
    color: var(--color-ink-light);
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    gap: 0.4rem;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  a:hover {
    color: var(--color-ink-deep);
  }

  /* :global because the Icon component's svg does not carry this component's
     scope attribute; anchored on the scoped `a`, so nothing leaks. The old
     glyph's stroke-width was 2, which is lucide's own, so no weight override. */
  a :global(svg) {
    flex: none;
  }
</style>

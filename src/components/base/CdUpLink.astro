---
import { parentPath } from '../../lib/routes';

const target = parentPath(Astro.url.pathname);
const label = target === '/' ? 'cd .. (back to the home page)' : `cd .. (back to ${target})`;
---

{
  target && (
    <div class="cd-up page" data-pagefind-ignore>
      <a href={target} aria-label={label}>
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 6l6 6-6 6" />
        </svg>
        <span>cd ..</span>
      </a>
    </div>
  )
}

<style>
  .cd-up {
    margin-block: 4rem 0;
  }

  a {
    align-items: center;
    color: var(--color-ink-light);
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    gap: 0.4rem;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  a:hover {
    color: var(--color-ink-deep);
  }

  svg {
    flex: none;
  }
</style>

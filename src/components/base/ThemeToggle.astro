---
/* A real button: chrome controls need keyboard and AT semantics. The
   design's no-buttons rule governs content actions, not the nav. */
---

<button id="theme-toggle" type="button" aria-label="Switch theme" title="Switch theme">
  <svg class="icon sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"></path>
  </svg>
  <svg class="icon moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5z"></path>
  </svg>
</button>

<script>
  import '../../scripts/theme';
</script>

<style>
  button {
    background: none;
    border: 0;
    padding: 0;
    color: var(--color-ink-light);
    cursor: pointer;
    display: inline-flex;
    transition: color var(--dur-fast) var(--ease-out);
  }

  button:hover {
    color: var(--color-ink-deep);
  }

  .moon {
    display: none;
  }

  :global([data-theme='dark']) .sun {
    display: none;
  }

  :global([data-theme='dark']) .moon {
    display: inline;
  }
</style>

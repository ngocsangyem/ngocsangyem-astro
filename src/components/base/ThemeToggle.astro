---
/* A real button: chrome controls need keyboard and AT semantics. The
   design's no-buttons rule governs content actions, not the nav. */
import { Icon } from 'astro-icon/components';
---

{/* The label names the theme a press switches to; theme.ts keeps it in step
    with the theme the head script applied before paint. */}
<button id="theme-toggle" type="button" aria-label="Switch theme" title="Switch theme">
  <Icon class="sun" name="lucide:sun" size={18} aria-hidden="true" />
  <Icon class="moon" name="lucide:moon" size={18} aria-hidden="true" />
</button>

<script>
  import '../../scripts/theme';
</script>

<style>
  /* The border is always there, transparent at rest, so the hover outline
     appears without nudging the bar. */
  button {
    align-items: center;
    background: none;
    block-size: 2.25rem;
    border: var(--border-hairline) solid transparent;
    color: var(--color-ink-3);
    cursor: pointer;
    display: inline-flex;
    inline-size: 2.25rem;
    justify-content: center;
    padding: 0;
    transition:
      color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out);
  }

  button:hover {
    border-color: var(--color-line);
    color: var(--color-ink);
  }

  /* Lucide bakes stroke-width 2 into the paths; the chrome keeps the lighter
     line the hand-drawn icons had. A rule on the paths outranks the baked
     presentation attribute, inheritance would not. */
  button :global(svg *) {
    stroke-width: 1.5;
  }

  /* :global because the Icon component's svg does not carry this component's
     scope attribute. Anchored on the scoped `button`, so nothing leaks. */
  button :global(.moon) {
    display: none;
  }

  :global([data-theme='dark']) button :global(.sun) {
    display: none;
  }

  :global([data-theme='dark']) button :global(.moon) {
    display: inline;
  }
</style>

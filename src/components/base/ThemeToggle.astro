---
/* A real button: chrome controls need keyboard and AT semantics. The
   design's no-buttons rule governs content actions, not the nav. */
import { Icon } from 'astro-icon/components';
---

<button id="theme-toggle" type="button" aria-label="Switch theme" title="Switch theme">
  <Icon class="sun" name="lucide:sun" size={18} aria-hidden="true" />
  <Icon class="moon" name="lucide:moon" size={18} aria-hidden="true" />
</button>

<script>
  import '../../scripts/theme';
</script>

<style>
  button {
    background: none;
    border: 0;
    padding: 0;
    color: var(--color-ink-light);
    cursor: pointer;
    display: inline-flex;
    transition: color var(--dur-fast) var(--ease-out);
  }

  button:hover {
    color: var(--color-ink-deep);
  }

  /* Lucide bakes stroke-width 2 into the paths; the chrome keeps the lighter
     line the hand-drawn icons had. A rule on the paths outranks the baked
     presentation attribute, inheritance would not. */
  button :global(svg *) {
    stroke-width: 1.5;
  }

  /* :global because the Icon component's svg does not carry this component's
     scope attribute. Anchored on the scoped `button`, so nothing leaks. */
  button :global(.moon) {
    display: none;
  }

  :global([data-theme='dark']) button :global(.sun) {
    display: none;
  }

  :global([data-theme='dark']) button :global(.moon) {
    display: inline;
  }
</style>

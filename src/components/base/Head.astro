---
import { Font } from 'astro:assets';
import { SITE } from '../../config/site';
import type { Post } from '../../lib/posts';

interface Props {
  title?: string;
  description?: string;
  /** Present on an article, which turns the page into an `article` for crawlers. */
  post?: Post;
}

const { title, description = SITE.description, post } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
// One URL shape per page: the sitemap and the feed both omit the trailing
// slash, and `trailingSlash: 'never'` was pinned so they could agree.
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '');
// Absolute: relative OG image URLs are ignored by most crawlers. A post gets the
// card cut for it by `pages/og/[id].png.ts`; everything else gets the artwork
// those cards are cut from.
const ogImage = new URL(
  post ? `/og/${post.id}.png` : '/og-default-dark.png',
  Astro.site,
).href;
const ogImageAlt = post ? post.data.title : SITE.description;

// Date only, no clock: the frontmatter carries no time of day, so a full
// timestamp would assert midnight UTC as fact.
const published = post ? post.data.date.toISOString().slice(0, 10) : undefined;

/**
 * One structured-data node per page, emitted as data rather than script. Posts
 * describe themselves as a BlogPosting; the home page identifies the site. Every
 * URL here reuses `canonical`, so structured data cannot disagree with the tag
 * above it.
 */
const structuredData = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.data.title,
      description,
      url: canonical,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      datePublished: published,
      image: ogImage,
      inLanguage: SITE.lang,
      author: { '@type': 'Person', name: SITE.author, url: SITE.url },
      publisher: { '@type': 'Person', name: SITE.author, url: SITE.url },
      ...(post.data.tags.length > 0 ? { keywords: post.data.tags.join(', ') } : {}),
    }
  : Astro.url.pathname === '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE.title,
        description: SITE.description,
        url: SITE.url,
        inLanguage: SITE.lang,
        author: { '@type': 'Person', name: SITE.author, url: SITE.url },
      }
    : null;
---

{/* Blocking and first: paint must never happen on the wrong paper. */}
<script is:inline>
  (function () {
    var root = document.documentElement;
    var stored = null;
    var drawn = null;
    try {
      stored = localStorage.getItem('theme');
      drawn = sessionStorage.getItem('mark-drawn');
    } catch (error) {
      // Storage blocked (private mode, cookie policy). OS preference stands in.
    }
    var theme =
      stored === 'light' || stored === 'dark'
        ? stored
        : window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
    root.dataset.theme = theme;
    root.dataset.pfTheme = theme;
    // Set before first paint, so only the first page of a visit animates the
    // mark and later navigations render it already drawn.
    if (drawn) root.dataset.markDrawn = 'true';
    try {
      sessionStorage.setItem('mark-drawn', '1');
    } catch (error) {
      // Storage blocked: the mark draws on each load, which is acceptable.
    }
  })();
</script>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

<meta property="og:type" content={post ? 'article' : 'website'} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{/* Declared, not left to be discovered: some crawlers skip a card whose image
    they would have to fetch and measure before rendering. */}
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:type" content="image/png" />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={SITE.lang} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{
  post && (
    <>
      <meta property="article:published_time" content={published} />
      <meta property="article:author" content={SITE.author} />
      {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

{/* Data, not behaviour: no executable script reaches the page from here. */}
{
  structuredData && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  )
}

{/* Preload only the faces that paint above the fold; the rest load on use. */}
<Font cssVariable="--font-inter" preload={[{ weight: '400' }, { weight: '600' }]} />
{/* Mono paints only inside code and tables, always below the fold on a cold
    load, so it swaps in on use instead of competing with the LCP text. */}
<Font cssVariable="--font-dm-mono" />
<Font cssVariable="--font-roboto-condensed" />

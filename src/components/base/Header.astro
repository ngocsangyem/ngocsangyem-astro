---
import { SITE } from "../../config/site";
import NavLink from "./NavLink.astro";
import Signature from "../identity/Signature.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SearchModal from "../search/SearchModal.astro";
---

<header id="top" class="site-header page" data-pagefind-ignore>
  <a class="mark-link" href="/" aria-label={`${SITE.author}, home`}>
    <Signature />
  </a>

  <nav aria-label="Main">
    {SITE.nav.map((link) => <NavLink href={link.href} label={link.label} />)}
    <SearchModal />
    <ThemeToggle />
  </nav>
</header>

<style>
  /* The frosted panel itself comes from `.site-header` in global.css, beside
     `.page-glass`, so the two glass surfaces cannot drift apart. */
  .site-header {
    align-items: center;
    display: flex;
    justify-content: space-between;
    min-height: var(--header-height);
    /* Without this the header panel and the page panel touch, and their rounded
       corners leave four notches of unblurred grove at the seam. */
    margin-block-end: 0.5rem;
    margin-block-start: 0.5rem;
    border-radius: 6.25rem;
  }

  .mark-link {
    color: var(--color-ink-deep);
    display: block;
    text-decoration: none;
  }

  nav {
    align-items: center;
    display: flex;
    gap: 1rem;
  }
</style>

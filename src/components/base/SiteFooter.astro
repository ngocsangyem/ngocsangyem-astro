---
import { SITE } from '../../config/site';

interface Props {
  /**
   * `false` drops the social links and email, for a page that already shows
   * them itself, so no page offers the same links twice.
   */
  socials?: boolean;
}

const { socials = true } = Astro.props;
// Build time is the publish time on a static site.
const year = new Date().getFullYear();
---

<footer class="site-footer page" data-pagefind-ignore>
  <div class="row">
    <span class="brand">{SITE.title}</span>
    <span class="copyright">© <span class="num">{year}</span> {SITE.author}</span>
  </div>

  <div class="row">
    <ul class="links" role="list">
      <li><a href="/rss.xml">RSS<span aria-hidden="true"> ↗</span></a></li>
      {
        socials &&
          SITE.socials.map((social) => (
            <li>
              <a href={social.href} rel="me noopener">
                {social.label}
                <span aria-hidden="true"> ↗</span>
              </a>
            </li>
          ))
      }
      {
        socials && SITE.email && (
          <li>
            <a class="email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </li>
        )
      }
    </ul>

    {
      /* Hidden until the keyboard layer loads and wires it: a switch that does
         nothing should not be offered. Stays visible on touch devices, so a
         reader can always turn shortcuts back on. The accessible name stays
         "Shortcuts" and aria-pressed carries the state, so the visible ": On"
         is hidden from AT rather than announced twice. */
    }
    <button class="shortcuts" type="button" data-shortcuts-toggle aria-pressed="true" hidden>
      Shortcuts<span aria-hidden="true">: <span data-shortcuts-state>On</span></span>
    </button>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: var(--border-hairline) solid var(--color-line);
    color: var(--color-ink-3);
    display: grid;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    gap: var(--space-3);
    letter-spacing: var(--tracking-label);
    margin-block-start: var(--space-12);
    /* The end padding clears the sticky back-to-top control, which comes to
       rest over the last stretch of the page. */
    padding-block: var(--space-6) calc(var(--control-size) + var(--space-8));
  }

  .row {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    justify-content: space-between;
  }

  .brand {
    color: var(--color-ink);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
  }

  /* Labels are uppercase by CSS; the address is not a label and keeps its case. */
  .links a:not(.email) {
    text-transform: uppercase;
  }

  a,
  .shortcuts {
    color: inherit;
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  a:hover,
  .shortcuts:hover {
    color: var(--color-ink);
  }

  .shortcuts {
    background: none;
    border: 0;
    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    padding: 0;
    text-transform: uppercase;
  }
</style>

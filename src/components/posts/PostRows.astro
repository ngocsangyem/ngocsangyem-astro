---
import { groupPostsByYear, type Post } from '../../lib/posts';
import PostRow from './PostRow.astro';

interface Props {
  posts: Post[];
  /** Year chapters with a ghost numeral behind the first rows. */
  grouped?: boolean;
}

const { posts, grouped = false } = Astro.props;
const groups = grouped ? groupPostsByYear(posts) : [];

/** Index across the whole list so the stagger does not restart each year. */
const stageOf = new Map(
  (grouped ? groups.flatMap((group) => group.posts) : posts).map((post, index) => [post.id, index]),
);
---

{
  grouped ? (
    <div class="groups">
      {groups.map((group) => (
        <section class="group" data-year={group.year}>
          <h2 class="visually-hidden">{group.year}</h2>
          <div class="rows">
            {group.posts.map((post) => <PostRow post={post} stage={stageOf.get(post.id)} />)}
          </div>
        </section>
      ))}
    </div>
  ) : (
    <div class="rows">
      {posts.map((post, index) => <PostRow post={post} stage={index} />)}
    </div>
  )
}

<style>
  .groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-9);
  }

  .group {
    position: relative;
    /* Keeps the numeral's z-index: -1 inside this section rather than dropping
       it behind the page background. */
    isolation: isolate;
    /* Room for the numeral, whose lower half sits behind the first rows. */
    padding-block-start: 2.75rem;
    /* Clip rather than hide: the numeral runs wider than the column on purpose. */
    overflow: clip;
  }

  .group::before {
    content: attr(data-year);
    color: transparent;
    font-family: var(--font-display);
    font-size: 5.5rem;
    /* 600 is the heaviest face that ships; the stroke, not the fill, draws
       this numeral, so the step down from 700 is invisible. */
    font-weight: 600;
    inset-inline-start: -0.04em;
    line-height: 0.85;
    opacity: 0.5;
    pointer-events: none;
    position: absolute;
    inset-block-start: 0;
    -webkit-text-stroke: 1px var(--color-ink-light);
    user-select: none;
    z-index: -1;
  }

  .rows {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 48rem) {
    .group {
      padding-block-start: var(--space-9);
    }

    .group::before {
      font-size: 7.5rem;
    }
  }
</style>

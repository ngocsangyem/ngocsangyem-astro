---
import { formatDateShort, toISODate } from '../../lib/dates';
import { postUrl, type Post } from '../../lib/posts';

interface Props {
  post: Post;
  minutes?: number;
}

const { post, minutes } = Astro.props;
const date = post.data.date;
const tag = post.data.tags[0];
---

<article class="featured" aria-labelledby="featured-title">
  <p class="label">Featured</p>
  <h2 class="title" id="featured-title">
    <a href={postUrl(post)}>{post.data.title}</a>
  </h2>
  <p class="meta" data-pagefind-ignore>
    <time datetime={toISODate(date)}>{formatDateShort(date)}</time>
    {tag && <><span aria-hidden="true"> · </span><span>{tag}</span></>}
    {
      minutes !== undefined && (
        <>
          <span aria-hidden="true"> · </span>
          <span class="num">{minutes} min</span>
        </>
      )
    }
  </p>
</article>

<style>
  /* Top rule only: the list that follows draws its own top border, so a rule
     here as well would double the line. */
  .featured {
    border-block-start: var(--border-hairline) solid var(--color-line);
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-6);
  }

  /* Meta keeps the rows' own casing ("Oct 08, 2026 · 4 min"), so the featured
     post and the list below it read the same way; only the label is uppercase. */
  .label,
  .meta {
    color: var(--color-ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
  }

  .label {
    text-transform: uppercase;
  }

  .title {
    font-size: var(--text-h1);
    font-weight: 500;
    line-height: 1.3;
  }

  .title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
</style>

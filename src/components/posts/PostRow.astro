---
import { formatDateShort, toISODate } from '../../lib/dates';
import { postUrl, type Post } from '../../lib/posts';

interface Props {
  post: Post;
  /** Reading time in whole minutes; the column is left empty without it. */
  minutes?: number;
}

const { post, minutes } = Astro.props;
const date = post.data.date;
---

{
  /* The whole row is one link. The title comes first in the markup so it leads
     the link's accessible name; grid areas put the date first on screen. */
}
<li class="row-item">
  <a class="row" href={postUrl(post)}>
    <span class="title">{post.data.title}</span>
    <time class="date" datetime={toISODate(date)}>{formatDateShort(date)}</time>
    {
      minutes !== undefined && (
        <span class="time">
          <span aria-hidden="true">{minutes} min</span>
          <span class="visually-hidden">{minutes} {minutes === 1 ? 'minute' : 'minutes'}</span>
        </span>
      )
    }
  </a>
</li>

<style>
  .row-item {
    border-block-end: var(--border-hairline) solid var(--color-line-soft);
  }

  /* Hover is an instant row fill, never movement. */
  .row {
    align-items: baseline;
    column-gap: var(--space-4);
    display: grid;
    grid-template-areas: 'date title time';
    grid-template-columns: 8.5rem 1fr 5rem;
    padding-block: var(--space-3);
    padding-inline: var(--space-2);
    text-decoration: none;
  }

  .row:hover {
    background-color: var(--color-hover-row);
  }

  .title {
    color: var(--color-ink);
    font-size: var(--text-ui);
    grid-area: title;
  }

  .date,
  .time {
    color: var(--color-ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-label);
  }

  .date {
    grid-area: date;
  }

  .time {
    grid-area: time;
    text-align: end;
  }

  /* Narrow: the title takes the full first line, date and time share the second. */
  @media (max-width: 39.99rem) {
    .row {
      grid-template-areas:
        'title title'
        'date time';
      grid-template-columns: 1fr auto;
      row-gap: var(--space-2);
    }
  }
</style>

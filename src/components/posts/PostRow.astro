---
import { formatDate, toISODate } from '../../lib/dates';
import { postUrl, type Post } from '../../lib/posts';

interface Props {
  post: Post;
  /** Position in the whole list, for the reveal stagger. */
  stage?: number;
}

const { post, stage } = Astro.props;
const date = post.data.date;
---

<a
  class="row"
  href={postUrl(post)}
  data-enter={stage === undefined ? undefined : ''}
  style={stage === undefined ? undefined : `--enter-stage: ${stage}`}
>
  <span class="title">{post.data.title}</span>
  <time class="date" datetime={toISODate(date)}>{formatDate(date)}</time>
</a>

<style>
  /* Hover steps colour along the ink ramp rather than fading opacity: a rested
     op50 would push muted text under the 4.5:1 floor. */
  .row {
    align-items: baseline;
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
    padding-block: 0.45rem;
    text-decoration: none;
  }

  .title {
    color: var(--color-ink);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .row:hover .title {
    color: var(--color-ink-deep);
  }

  .date {
    color: var(--color-ink-light);
    flex: none;
    font-size: 0.8125rem;
  }

  /* 0.45rem of padding puts a row at roughly 40px, and rows are flush against
     each other, so on a touch screen the miss lands on the neighbouring post
     rather than on nothing. Loosened only where the pointer is coarse: this is
     the site's primary navigation, and desktop keeps its density. */
  @media (pointer: coarse) {
    .row {
      padding-block: 0.65rem;
    }
  }
</style>

---
import { Picture } from 'astro:assets';
import { SITE } from '../../config/site';
import { formatDateShort, toISODate } from '../../lib/dates';
import { galleryTransitionName, getFirstTag, tagUrl, type Post } from '../../lib/posts';

interface Props {
  post: Post;
  minutesRead?: number;
}

const { post, minutesRead } = Astro.props;
const firstTag = getFirstTag(post);
// Only a post with a cover has a gallery tile to travel from, so only it names
// its title; the rest keep the plain page dissolve.
const travel = post.data.cover ? `view-transition-name: ${galleryTransitionName('title', post.id)}; ` : '';
// Only a declared description is a standfirst; the generated excerpt would
// just repeat the first paragraph a few lines below.
const standfirst = post.data.description?.trim();
---

{
  /* Matter / Substack: a small topic line, the title, an optional cover
     banner, an optional standfirst and one quiet meta line, closed by a
     hairline. On the way in from /gallery the tile's drawing grows into the
     banner and its caption travels up into the title. */
}
<header class="hero">
  {
    firstTag && (
      <a class="topic mono-label" href={tagUrl(firstTag.slug)} data-enter data-pagefind-ignore>
        {firstTag.label}
      </a>
    )
  }
  <h1 class="title" data-enter style={`${travel}--enter-stage: 1`}>{post.data.title}</h1>
  {
    /* Shares its view-transition-name with the gallery tile, so opening a post
       from /gallery grows the tile into this image instead of cutting to it.
       Eager and high priority: it is the largest thing above the fold, and the
       morph reads poorly if the image lands after the transition ends. */
    post.data.cover && (
      <Picture
        class="post-cover"
        src={post.data.cover}
        alt={post.data.coverAlt ?? ''}
        formats={['avif', 'webp']}
        widths={[640, 960, 1312]}
        sizes="(min-width: 41rem) 41rem, 100vw"
        loading="eager"
        fetchpriority="high"
        style={`view-transition-name: ${galleryTransitionName('cover', post.id)}; --cover-ratio: ${post.data.cover.width / post.data.cover.height}`}
        data-pagefind-ignore
      />
    )
  }
  {standfirst && <p class="standfirst" data-enter style="--enter-stage: 2">{standfirst}</p>}
  {/* Chrome, not content: kept out of search excerpts. */}
  <p class="meta" data-enter style="--enter-stage: 3" data-pagefind-ignore>
    <span>{SITE.author}</span>
    <span aria-hidden="true">·</span>
    <time datetime={toISODate(post.data.date)}>{formatDateShort(post.data.date)}</time>
    {
      minutesRead !== undefined && (
        <>
          <span aria-hidden="true">·</span>
          <span class="num">{minutesRead} min read</span>
        </>
      )
    }
  </p>
</header>

<style>
  .hero {
    border-block-end: var(--border-hairline) solid var(--color-line-soft);
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    margin-block: var(--space-8);
    padding-block-end: var(--space-6);
  }

  /* The <picture> wrapper is the grid item, and `justify-items: start` would
     shrink-wrap it around an image sized at 100% of it: a circular width that
     collapses to a few pixels while the file is still downloading. On an
     uncached visit the browser snapshots that collapsed box, so the morph
     shrank the tile to a dot and the cover then jumped to full size. Stretched,
     the box has its real size before a single byte of the image arrives. */
  .hero > :global(picture) {
    justify-self: stretch;
  }

  /* No background on purpose: until the file loads the image must be
     transparent, so the gallery tile's snapshot shows through it during the
     morph instead of being covered by a blank panel.
     The banner keeps the drawing's own shape, so the gallery tile morphs into
     the same proportions. Its size comes from the ratio alone, never from the
     loaded file: full width, but no taller than 32rem, which narrows an
     upright or square drawing instead of letting it take over the page. */
  .hero :global(.post-cover) {
    aspect-ratio: var(--cover-ratio);
    border: var(--border-hairline) solid var(--color-line-soft);
    inline-size: min(100%, 32rem * var(--cover-ratio));
    margin-block-end: var(--space-2);
    object-fit: cover;
    view-transition-class: cover;
  }

  /* Shrink-wrapped and tagged for the heading morph: a snapshot as wide as its
     text scales evenly from the tile's smaller setting instead of stretching
     the row's empty end. */
  .title {
    view-transition-class: post-heading;
  }

  .topic {
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .topic:hover {
    color: var(--color-ink);
  }

  .title {
    font-size: var(--text-h1);
    font-weight: 500;
    line-height: 1.3;
  }

  .standfirst {
    color: var(--color-ink-2);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .meta {
    color: var(--color-ink-3);
    display: flex;
    flex-wrap: wrap;
    font-size: var(--text-label);
    gap: var(--space-2);
  }

  /* One voice for the whole line, not a mono date in a sans sentence. */
  .meta time {
    font-family: inherit;
  }
</style>

---
import { Picture } from 'astro:assets';
import { formatDateShort, toISODate } from '../../lib/dates';
import { galleryTransitionName, postUrl, type CoveredPost } from '../../lib/posts';

interface Props {
  post: CoveredPost;
  /** Tiles in the first screen load eagerly; the rest wait until scrolled near. */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const { cover } = post.data;
const name = (part: 'cover' | 'title') => `view-transition-name: ${galleryTransitionName(part, post.id)}`;
---

{
  /* The drawing at its own shape, captioned underneath; nothing is laid over
     it. The title names the link, so the drawing itself is decorative here;
     the post page shows it with its real alt text. */
}
<a class="tile" href={postUrl(post)}>
  <Picture
    class="tile-image"
    src={cover}
    alt=""
    formats={['avif', 'webp']}
    widths={[400, 640, 960]}
    sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 100vw"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    style={`${name('cover')}; --cover-ratio: ${cover.width / cover.height}`}
  />
  <span class="title" style={name('title')}>{post.data.title}</span>
  <time class="date" datetime={toISODate(post.data.date)}>{formatDateShort(post.data.date)}</time>
</a>

<style>
  .tile {
    color: var(--color-ink);
    display: grid;
    gap: var(--space-2);
    text-decoration: none;
  }

  /* Full column width, never shrink-wrapped: the picture and image take a
     definite box from the ratio before a byte of the file arrives, which is
     what the board measures and what the morph into the post snapshots. */
  .tile > :global(picture) {
    display: block;
    margin-block-end: var(--space-1);
  }

  .tile :global(.tile-image) {
    aspect-ratio: var(--cover-ratio);
    border: var(--border-hairline) solid var(--color-line-soft);
    display: block;
    inline-size: 100%;
    max-inline-size: none;
    object-fit: cover;
    transition: border-color var(--motion-fast) var(--ease-out);
    view-transition-class: cover;
  }

  .title {
    font-size: var(--text-ui);
    font-weight: 500;
    justify-self: start;
    line-height: 1.35;
    transition: color var(--motion-fast) var(--ease-out);
    view-transition-class: post-heading;
  }

  .date {
    color: var(--color-ink-3);
    font-size: var(--text-label);
  }

  /* A colour step, never a lift or a zoom: the only scale a tile gets is the
     morph into the post it opens. */
  .tile:hover :global(.tile-image) {
    border-color: var(--color-line);
  }

  .tile:hover .title {
    color: var(--color-accent-text);
  }

  .tile:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: var(--space-1);
  }
</style>

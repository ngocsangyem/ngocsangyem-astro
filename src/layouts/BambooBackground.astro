---
/**
 * BambooCanvas.astro
 *
 * A bamboo grove background drawn with Canvas 2D. No external assets, no build
 * step, no masks, no blend modes. Transparency is native and the ink colour is
 * just a fillStyle.
 *
 * How the work is split:
 *   - Drawing: Canvas 2D, each frame paints only what is new. Median 0.04 ms/frame.
 *   - Wind: CSS skewX on the three depth layers, pure compositor.
 *   - Once the grove has finished growing, no JavaScript runs at all.
 *
 *   <div style="position:relative;min-height:100vh">
 *     <BambooCanvas />
 *     <main>...</main>
 *   </div>
 *
 *   <BambooCanvas fixed wind={false} density="sparse" />
 *
 * Grove geometry lives in `src/lib/bamboo-geometry.ts`; this file is only the
 * drawing backend. compose() emits strokes, here they become brush stamps.
 */

export interface Props {
    /** Fixed seed for a repeatable layout. Omit for a new one each load. */
    seed?: number;
    /** How many culms in the grove. */
    density?: "sparse" | "normal" | "dense";
    /** `false` turns wind off. `true` is the default level, or a number from 0 to 2. */
    wind?: boolean | number;
    /** Grow in on load, or show the finished grove straight away. */
    animate?: boolean;
    /**
     * Draw the grove once per visit. On every later page of the same session it
     * appears already finished.
     *
     * On a multi-page site the reveal is not a first-run flourish, it is
     * something the reader sits through on every navigation. By the fifth page
     * it has stopped being a welcome and become a wait.
     */
    once?: boolean;
    /**
     * How the grove appears.
     *  `ink`  each stroke lands as a drop of ink and bleeds out to fill its shape.
     *  `grow` culms shoot up from the root, leaves open afterwards.
     *  `wipe` a real rotating ink wash uncovers the whole frame. Needs a sprite
     *         file; see `wipeSrc`.
     */
    reveal?: "ink" | "grow" | "wipe";
    /**
     * Sprite for `wipe` mode: a GREYSCALE image, 25 frames side by side, where
     * grey level means coverage. Derived from codyhouse/ink-transition-effect,
     * so check their licence before shipping this.
     */
    wipeSrc?: string;
    /**
     * Seconds for one drop of ink to bleed across its stroke.
     * To slow the whole thing down widen `duration`, not this. A long bleed
     * leaves many strokes spreading at once and doubles p95. Slow calligraphy
     * lives in the pauses between strokes; each stroke itself stays decisive.
     */
    bleed?: number;
    /** Seconds to grow. */
    duration?: number;
    /** A shoot at the foot of the clump, printed in gamboge and cinnabar. */
    shoot?: boolean;
    /** 'auto' follows prefers-color-scheme and class/data-theme on <html>. */
    theme?: "light" | "dark" | "auto";
    paperLight?: string;
    paperDark?: string;
    inkLight?: string;
    inkDark?: string;
    /**
     * Logical pixel budget for all three layers combined. Three full-screen
     * canvases at 1920x1080 @dpr2 cost 95 MB, and Safari on iPhone kills the
     * tab for it.
     */
    maxPixels?: number;
    fixed?: boolean;
    class?: string;
}

const {
    seed,
    density = "normal",
    wind = true,
    animate = true,
    once = false,
    reveal = "ink",
    wipeSrc = "/bamboo-ink-wipe.webp",
    bleed = 0.5,
    duration = 3,
    shoot = true,
    theme = "auto",
    paperLight = "#d3cec4",
    paperDark = "#1a2023",
    inkLight = "#191c1a",
    inkDark = "#e8e6dc",
    maxPixels = 4_000_000,
    fixed = false,
    class: className = "",
} = Astro.props;

const windAmount = wind === true ? 1 : wind === false ? 0 : wind;
---

<div
    class:list={["bamboo-canvas", fixed && "is-fixed", className]}
    data-bamboo-canvas
    data-seed={seed ?? ""}
    data-density={density}
    data-wind={windAmount}
    data-animate={animate ? "1" : "0"}
    data-once={once ? "1" : "0"}
    data-reveal={reveal}
    data-bleed={bleed}
    data-wipe-src={wipeSrc}
    data-duration={duration}
    data-shoot={shoot ? "1" : "0"}
    data-theme-mode={theme}
    data-paper-light={paperLight}
    data-paper-dark={paperDark}
    data-ink-light={inkLight}
    data-ink-dark={inkDark}
    data-max-pixels={maxPixels}
    aria-hidden="true"
    style={`--paper-light:${paperLight};--paper-dark:${paperDark}${theme === "auto" ? "" : `;--paper:${theme === "dark" ? paperDark : paperLight}`}`}
>
</div>

<style>
    /* The paper colour has to be right on the FIRST paint. The script that
       decides it is a module, so it runs after parse; anything the build
       hard-codes here is a full-viewport flash of the wrong paper until then.
       So in `auto` mode CSS picks the colour, mirroring detectTheme()'s
       precedence, off the `data-theme` a blocking head script stamps on <html>
       before paint. The script's later `--paper` write lands on the same value
       and wins the cascade for the rest of the session. */
    .bamboo-canvas {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        user-select: none;
        /* The ink repaints instantly on a theme swap, so a slow paper fade would
           leave the two visibly out of step. Matching the site's own swap
           duration keeps the mismatch under the threshold where it reads as a
           crossfade of two separate things. */
        background: var(--paper, var(--paper-light, #d3cec4));
        transition: background-color var(--dur-fast, 150ms)
            var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
    }
    :global(html[data-theme="dark"]) .bamboo-canvas,
    :global(html[data-color-scheme="dark"]) .bamboo-canvas,
    :global(html.dark) .bamboo-canvas {
        background: var(--paper, var(--paper-dark, #1a2023));
    }
    /* No explicit marker on <html> (JS off, or a host that never stamps one):
       fall back to the OS preference, same as detectTheme() does. */
    @media (prefers-color-scheme: dark) {
        :global(
                html:not([data-theme]):not([data-color-scheme]):not(.dark):not(
                        .light
                    )
            )
            .bamboo-canvas {
            background: var(--paper, var(--paper-dark, #1a2023));
        }
    }
    .bamboo-canvas.is-fixed {
        position: fixed;
        z-index: -1;
    }

    /* On a phone the reading panel covers nearly the whole viewport, so the
       grove is reduced to two 1rem slivers — cost without payoff. Same 48rem
       cutoff as the panel margins in global.css. The script checks the same
       media query and skips painting entirely, this rule only guards the
       flash before it runs. */
    @media (max-width: 48rem) {
        .bamboo-canvas {
            display: none;
        }
    }

    /* The grove is painted in one synchronous pass whenever it is not growing
       in (repeat visit, resize, reduced motion). Without this it would simply
       appear between two frames. Opacity only: a background that scales or
       slides on arrival announces itself, and this one should just be there.
       Kept for reduced motion too, where a fade is the gentler option, not the
       motion being removed. */
    .bamboo-canvas :global(.bb-depth) {
        position: absolute;
        inset: 0;
        transform-origin: 50% 100%;
        opacity: 0;
        transition: opacity 600ms
            var(--ease-out, cubic-bezier(0.16, 1, 0.3, 1));
    }
    .bamboo-canvas[data-bamboo-painted] :global(.bb-depth) {
        opacity: 1;
    }
    /* skewX shifts x with height and leaves y alone, so the roots stay pinned to
     the ground. rotate would see-saw the whole frame.

     The waveform is a slow fundamental plus a second and third harmonic, each
     phase-shifted, sampled to 16 stops and normalised so the peak still lands
     exactly on `--sk`. A single sine ping-ponging with `alternate` reads as a
     metronome once you have watched it for a minute; the harmonics make the
     lean one way linger and the pull back arrive sooner, which is what a breeze
     does. 0% and 100% are the same value, so the loop has no seam.

     `linear` between stops on purpose: the curve is already in the numbers, and
     easing each segment would ease a waveform that has its own velocity.

     One animation on one element, not a second one on the canvas inside: the
     scratch canvas is added part-way through the reveal and would start its own
     animation at a different time, drifting out of phase with its own layer. */
    .bamboo-canvas :global(.bb-depth.bb-sway) {
        animation: bb-sway var(--sd) linear var(--dly) infinite;
    }
    @keyframes bb-sway {
        0% {
            transform: skewX(calc(var(--sk) * 0.237))
                translateX(calc(var(--tx) * 0.237));
        }
        6.25% {
            transform: skewX(calc(var(--sk) * 0.588))
                translateX(calc(var(--tx) * 0.588));
        }
        12.5% {
            transform: skewX(calc(var(--sk) * 0.663))
                translateX(calc(var(--tx) * 0.663));
        }
        18.75% {
            transform: skewX(calc(var(--sk) * 0.616))
                translateX(calc(var(--tx) * 0.616));
        }
        25% {
            transform: skewX(calc(var(--sk) * 0.605))
                translateX(calc(var(--tx) * 0.605));
        }
        31.25% {
            transform: skewX(calc(var(--sk) * 0.619))
                translateX(calc(var(--tx) * 0.619));
        }
        37.5% {
            transform: skewX(calc(var(--sk) * 0.531))
                translateX(calc(var(--tx) * 0.531));
        }
        43.75% {
            transform: skewX(calc(var(--sk) * 0.295))
                translateX(calc(var(--tx) * 0.295));
        }
        50% {
            transform: skewX(calc(var(--sk) * 0.01))
                translateX(calc(var(--tx) * 0.01));
        }
        56.25% {
            transform: skewX(calc(var(--sk) * -0.207))
                translateX(calc(var(--tx) * -0.207));
        }
        62.5% {
            transform: skewX(calc(var(--sk) * -0.37))
                translateX(calc(var(--tx) * -0.37));
        }
        68.75% {
            transform: skewX(calc(var(--sk) * -0.583))
                translateX(calc(var(--tx) * -0.583));
        }
        75% {
            transform: skewX(calc(var(--sk) * -0.852))
                translateX(calc(var(--tx) * -0.852));
        }
        81.25% {
            transform: skewX(calc(var(--sk) * -1))
                translateX(calc(var(--tx) * -1));
        }
        87.5% {
            transform: skewX(calc(var(--sk) * -0.824))
                translateX(calc(var(--tx) * -0.824));
        }
        93.75% {
            transform: skewX(calc(var(--sk) * -0.327))
                translateX(calc(var(--tx) * -0.327));
        }
        100% {
            transform: skewX(calc(var(--sk) * 0.237))
                translateX(calc(var(--tx) * 0.237));
        }
    }
    .bamboo-canvas :global(canvas.bb-cover) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }
    .bamboo-canvas :global(canvas) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    @media (prefers-reduced-motion: reduce) {
        .bamboo-canvas :global(.bb-depth.bb-sway) {
            animation: none;
        }
    }
</style>

<script>
    /* Only this gate ships to every viewport. The painting itself — geometry,
       brush, noise tile, render loop — is a separate chunk behind a dynamic
       import that never runs below 48rem, so a phone downloads none of it.
       Same cutoff as the display:none rule above and the panel margins in
       global.css. Crossing the boundary upward (rotation, a desktop window
       widening) loads and initialises then; crossing downward just lets the
       CSS hide the finished grove. */
    const smallViewport = matchMedia("(max-width: 48rem)");

    async function boot() {
        if (smallViewport.matches) return;
        const { initAll } = await import("../lib/bamboo-canvas");
        initAll();
    }

    boot();
    smallViewport.addEventListener("change", (e) => {
        if (!e.matches) boot();
    });
    document.addEventListener("astro:page-load", boot);
</script>

---
import Head from "../components/base/Head.astro";
import Header from "../components/base/Header.astro";
import CdUpLink from "../components/base/CdUpLink.astro";
import SiteFooter from "../components/base/SiteFooter.astro";
import HotkeyHelp from "../components/base/HotkeyHelp.astro";
import ReadingProgress from "../components/posts/ReadingProgress.astro";
import ToTopLink from "../components/base/ToTopLink.astro";
import { SITE } from "../config/site";
import type { Post } from "../lib/posts";

import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/shiki.css";
import "../styles/animations.css";

interface Props {
  title?: string;
  description?: string;
  /** Widens the main container so an article can use the margin beside it. */
  wide?: boolean;
  /** Handed to the head so an article can describe itself as one. */
  post?: Post;
  /**
   * `false` drops the footer's social links and email. For a page that already
   * shows the same links itself, so they are not offered twice on one screen.
   */
  socials?: boolean;
  /** Expands both page chrome and content for editorial compositions. */
  canvas?: "prose" | "wide";
}

const {
  title,
  description,
  wide = false,
  post,
  socials = true,
  canvas = "prose",
} = Astro.props;

const isWideCanvas = canvas === "wide";
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Head title={title} description={description} post={post} />
  </head>
  <body>
    {
      /* Outside <main> on purpose: a transformed or filtered ancestor would
        become the containing block for this fixed bar and let it scroll away
        with the page. */
    }
    {post && <ReadingProgress />}
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main
      id="main"
      class:list={["page", { "page-wide": wide, "page-canvas-wide": isWideCanvas }]}
      data-pagefind-body
    >
      <slot />
    </main>
    <CdUpLink />
    <SiteFooter socials={socials} />
    {
      /* Last in the DOM so it lands last in the tab order, after the page's own
        links, rather than interrupting them from a fixed corner. */
    }
    <ToTopLink />
    <HotkeyHelp />
    {/* Theme, search and the keyboard layer, as one script. */}
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>

---
import Head from "../components/base/Head.astro";
import Header from "../components/base/Header.astro";
import CdUpLink from "../components/base/CdUpLink.astro";
import SocialRow from "../components/base/SocialRow.astro";
import ToTopLink from "../components/base/ToTopLink.astro";
import BambooBackground from "./BambooBackground.astro";
import { SITE } from "../config/site";
import type { Post } from "../lib/posts";

import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/shiki.css";
import "../styles/animations.css";

interface Props {
  title?: string;
  description?: string;
  /** Widens the main container so an article can use the margin beside it. */
  wide?: boolean;
  /** Paints the bamboo grove behind the page instead of flat paper. */
  background?: boolean;
  /** Handed to the head so an article can describe itself as one. */
  post?: Post;
  /**
   * `false` drops the footer contact line. For a page that already shows the
   * same links itself, so they are not offered twice on one screen.
   */
  socials?: boolean;
}

const {
  title,
  description,
  wide = false,
  background = false,
  post,
  socials = true,
} = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Head title={title} description={description} post={post} />
  </head>
  <body>
    {
      /* `auto` tracks the `data-theme` the head script stamps on <html>, so the
       grove follows the toggle without a second source of truth. */
    }
    {background && <BambooBackground wind={0.55} animate once fixed theme="auto" />}
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main
      id="main"
      class:list={["page page-glass", { "page-wide": wide }]}
      data-pagefind-body
    >
      <slot />
    </main>
    <CdUpLink />
    {socials && <SocialRow />}
    {
      /* Last in the DOM so it lands last in the tab order, after the page's own
        links, rather than interrupting them from a fixed corner. */
    }
    <ToTopLink />
  </body>
</html>

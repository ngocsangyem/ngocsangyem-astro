---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryTile from '../components/gallery/GalleryTile.astro';
import { getCoveredPosts, getPublishedPosts } from '../lib/posts';

// A post joins the gallery by declaring a cover; there is nothing to list here.
const posts = getCoveredPosts(await getPublishedPosts());
const description = 'The posts, drawn by hand.';
// The first row of the widest board fills the first screen.
const EAGER_TILES = 3;
---

<BaseLayout title="Gallery" description={description}>
  <div class="gallery-page">
    <header class="head">
      <div>
        <h1 class="page-title" data-enter>Gallery</h1>
        <p class="page-tagline" data-enter style="--enter-stage: 1">{description}</p>
      </div>
      <p class="mono-label count" data-enter style="--enter-stage: 2">
        <span class="num">{posts.length}</span> {posts.length === 1 ? 'drawing' : 'drawings'}
      </p>
    </header>
    <ul class="board" role="list" data-masonry>
      {
        posts.map((post, index) => (
          <li>
            <GalleryTile post={post} eager={index < EAGER_TILES} />
          </li>
        ))
      }
    </ul>
    {
      /* Masonry that keeps reading order. A column-first masonry (CSS columns)
         reads down each column, so the newest drawings scatter and Tab jumps
         around; this one lays the first row out in date order, then drops each
         later drawing into the shortest column, so the board still reads left
         to right, newest first. The middle of three columns starts lower, so
         the top edge staggers like the bottom one instead of a ruled line.

         Classic and inline, right after the board, so it places the tiles
         before the first paint and before a Back navigation snapshots them.
         Every image box is sized from its ratio, so the measurements hold
         before the files load; the observers redo it when the width changes
         or a web font rewraps a title. Without script, the board is a plain
         grid in the same order. */
    }
    <script is:inline>
      (() => {
        const board = document.querySelector('[data-masonry]');
        if (!board || !('ResizeObserver' in window)) return;
        const tiles = [...board.children];
        let frame = 0;

        const place = () => {
          frame = 0;
          const style = getComputedStyle(board);
          const columns = style.gridTemplateColumns.split(' ').length;
          board.classList.toggle('is-masonry', columns > 1);
          if (columns < 2) {
            for (const tile of tiles) tile.style.gridArea = '';
            return;
          }
          const gap = parseFloat(style.columnGap) || 0;
          const tops = Array.from({ length: columns }, (_, column) => (columns > 2 && column === 1 ? gap * 2 : 0));
          tiles.forEach((tile, index) => {
            const column = index < columns ? index : tops.indexOf(Math.min(...tops));
            const height = Math.ceil(tile.getBoundingClientRect().height);
            tile.style.gridArea = `${tops[column] + 1} / ${column + 1} / span ${height} / span 1`;
            tops[column] += height + gap;
          });
        };

        place();
        const observer = new ResizeObserver(() => {
          frame ||= requestAnimationFrame(place);
        });
        observer.observe(board);
        for (const tile of tiles) observer.observe(tile);
      })();
    </script>
  </div>
</BaseLayout>

<style>
  .head {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: space-between;
    margin-block: var(--space-8);
  }

  .count {
    color: var(--color-ink-3);
  }

  .count .num {
    color: var(--color-ink);
  }

  .board {
    align-items: start;
    display: grid;
    gap: var(--space-8) var(--space-6);
    grid-template-columns: minmax(0, 1fr);
    margin: 0 0 var(--space-12);
  }

  /* The script places every tile on 1px rows; the gaps between tiles are
     added as it stacks them. */
  .board.is-masonry {
    grid-auto-rows: 1px;
    row-gap: 0;
  }

  @media (min-width: 40rem) {
    .board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .board {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostIndex from '../../components/posts/PostIndex.astro';
import {
  getAllTags,
  getPostsByTag,
  getPublishedPosts,
  getReadingTimes,
  getTopTags,
} from '../../lib/posts';

const TOP_TAGS = 5;

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return getAllTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: { tag, all: posts, posts: getPostsByTag(posts, tag.slug) },
  }));
}) satisfies GetStaticPaths;

const { tag, all, posts } = Astro.props;
const count = posts.length;
const minutes = await getReadingTimes(posts);
---

<BaseLayout title={`#${tag.label}`} description={`Posts tagged ${tag.label}.`}>
  <PostIndex
    title={`#${tag.label}`}
    tagline={`${count} ${count === 1 ? 'post' : 'posts'} tagged ${tag.label}.`}
    posts={posts}
    minutes={minutes}
    topTags={getTopTags(all, TOP_TAGS)}
    total={all.length}
    current={tag.slug}
    extra={tag}
  />
</BaseLayout>

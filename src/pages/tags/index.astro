---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPostsByTag, getPublishedPosts, tagUrl } from '../../lib/posts';

const posts = await getPublishedPosts();
// Frequency order, unlike a post's own tag list: this page is a map of what the
// blog is mostly about, so the biggest subjects belong at the top. Each tag
// carries its newest post, so a row says what the subject is, not just a name.
const tags = getAllTags(posts).map((tag) => ({ ...tag, latest: getPostsByTag(posts, tag.slug)[0] }));
const description = 'Every subject written about here.';
---

<BaseLayout title="Tags" description={description}>
  <div class="tags-page">
    <header class="head">
      <h1 class="page-title" data-enter>Tags</h1>
      <p class="page-tagline" data-enter style="--enter-stage: 1">{description}</p>
    </header>

    {
      tags.length > 0 ? (
        <section>
          <h2 class="mono-label group">
            {tags.length} {tags.length === 1 ? 'tag' : 'tags'} · {posts.length} {posts.length === 1 ? 'post' : 'posts'}
          </h2>
          <ul class="tags" role="list">
            {tags.map((tag) => (
              <li>
                <a href={tagUrl(tag.slug)}>
                  <span class="name">
                    <span class="hash" aria-hidden="true">#</span>
                    {tag.label}
                  </span>
                  <span class="count num">
                    {tag.count} {tag.count === 1 ? 'post' : 'posts'}
                  </span>
                </a>
                {
                  /* Outside the link, so a link to a tag is not named after a
                     post; the link's ::after still covers the whole row. */
                  tag.latest && <p class="latest">Latest: {tag.latest.data.title}</p>
                }
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <p class="empty">Nothing is tagged yet.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  /* A centred reading column, like the home page: the tag map is something to
     scan top to bottom, not a dashboard. */
  .tags-page {
    margin-inline: auto;
    max-inline-size: var(--prose-max-width);
  }

  .head {
    margin-block: var(--space-8) var(--space-7);
  }

  .group {
    margin-block-end: var(--space-3);
  }

  .tags {
    border-block-start: var(--border-hairline) solid var(--color-line);
    margin: 0;
  }

  .tags li {
    border-block-end: var(--border-hairline) solid var(--color-line-soft);
    position: relative;
  }

  /* One link per tag: name and count on the first line, the newest post's
     title under it. Hover is a row fill, never movement. */
  .tags a {
    align-items: baseline;
    column-gap: var(--space-4);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    padding: var(--space-4) var(--space-2) 0;
    text-decoration: none;
  }

  /* The link covers the whole row, latest line included, so hover and click
     still work across it. */
  .tags a::after {
    content: '';
    inset: 0;
    position: absolute;
  }

  .tags li:hover {
    background-color: var(--color-hover-row);
  }

  .name {
    color: var(--color-ink);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .hash {
    color: var(--color-ink-3);
    font-family: var(--font-mono);
    font-weight: 400;
    margin-inline-end: 0.1em;
  }

  .count {
    align-self: baseline;
    color: var(--color-ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
  }

  .latest {
    color: var(--color-ink-3);
    font-size: var(--text-label);
    line-height: 1.4;
    margin: var(--space-1) 0 0;
    padding: 0 var(--space-2) var(--space-4);
  }

  .empty {
    color: var(--color-ink-3);
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPublishedPosts, tagUrl } from '../../lib/posts';

const posts = await getPublishedPosts();
// Frequency order, unlike a post's own tag list: this page is a map of what the
// blog is mostly about, so the biggest subjects belong at the top.
const tags = getAllTags(posts);
const description = 'Every subject written about here.';
---

<BaseLayout title="Tags" description={description}>
  <div class="tags-page">
    <header class="head">
      <h1 class="page-title" data-enter>Tags</h1>
      <p class="page-tagline" data-enter style="--enter-stage: 1">{description}</p>
    </header>

    {
      tags.length > 0 ? (
        <section>
          <h2 class="group">
            Tags <span class="num">{tags.length}</span>
          </h2>
          <ul class="tags" role="list">
            {tags.map((tag) => (
              <li>
                <a href={tagUrl(tag.slug)}>
                  <span class="label">#{tag.label}</span>
                  <span class="leader" aria-hidden="true" />
                  <span class="tally num">
                    <span aria-hidden="true">{tag.count}</span>
                    <span class="visually-hidden">
                      , {tag.count} {tag.count === 1 ? 'post' : 'posts'}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <p class="empty">Nothing is tagged yet.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .tags-page {
    max-inline-size: 41rem;
  }

  .head {
    margin-block: var(--space-8) var(--space-7);
  }

  .group {
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    margin-block-end: var(--space-2);
    text-transform: uppercase;
  }

  .group .num {
    color: var(--color-ink-3);
    margin-inline-start: var(--space-2);
  }

  .tags {
    border-block-start: var(--border-hairline) solid var(--color-line-soft);
    margin: 0;
  }

  /* Rows rather than a cloud: counts only compare when they line up, and the
     dotted leader carries the eye from the tag to its number. */
  .tags a {
    align-items: baseline;
    border-block-end: var(--border-hairline) solid var(--color-line-soft);
    display: flex;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    gap: var(--space-3);
    letter-spacing: var(--tracking-label);
    padding: var(--space-3) var(--space-2);
    text-decoration: none;
  }

  .tags a:hover {
    background-color: var(--color-hover-row);
  }

  .label {
    color: var(--color-ink);
  }

  .leader {
    border-block-end: var(--border-hairline) dotted var(--color-line);
    flex: 1;
  }

  .tally {
    color: var(--color-ink-3);
  }

  .empty {
    color: var(--color-ink-3);
  }
</style>

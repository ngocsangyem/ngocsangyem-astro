---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRows from "../../components/posts/PostRows.astro";
import { getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
---

<BaseLayout
  background
  title="Posts"
  description="Notes on building things for the web."
>
  <div class="prose-column" data-enter-children>
    <h1>Posts</h1>
    <PostRows posts={posts} grouped />
  </div>
</BaseLayout>

<style>
  h1 {
    font-size: 1.75rem;
    margin-block: 1rem 3rem;
  }
</style>

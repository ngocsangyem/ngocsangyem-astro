---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostIndex from "../../components/posts/PostIndex.astro";
import { getPublishedPosts, getReadingTimes, getTopTags } from "../../lib/posts";

const TOP_TAGS = 5;
const posts = await getPublishedPosts();
const minutes = await getReadingTimes(posts);
const description = "Notes on building things for the web.";
---

<BaseLayout title="Posts" description={description}>
  <PostIndex
    title="Posts"
    tagline={description}
    posts={posts}
    minutes={minutes}
    topTags={getTopTags(posts, TOP_TAGS)}
    total={posts.length}
  />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRows from '../components/posts/PostRows.astro';
import { SITE } from '../config/site';
import { getPublishedPosts } from '../lib/posts';

const RECENT_COUNT = 6;
const posts = await getPublishedPosts();
const recent = posts.slice(0, RECENT_COUNT);
const hasMore = posts.length > recent.length;
---

<BaseLayout>
  {/* Rows carry their own stagger, so the wrapper must not add a second one. */}
  <div class="prose-column">
    {/* The masthead is a link, so the page still needs a top-level heading. */}
    <h1 class="visually-hidden">{SITE.title}</h1>
    {SITE.greeting && <p class="greeting" data-enter>{SITE.greeting}</p>}

    <section data-enter>
      <h2 class="heading">Recent</h2>
      <PostRows posts={recent} />
      {hasMore && (
        <p class="more">
          <a href="/posts">All posts</a>
        </p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .greeting {
    color: var(--color-ink);
    font-size: 1.125rem;
    line-height: 1.7;
    margin-block: 1.5rem 3.5rem;
    max-width: 44ch;
  }

  .heading {
    color: var(--color-ink-light);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .more {
    color: var(--color-ink-light);
    font-size: 0.9375rem;
    margin-top: 1.5rem;
  }
</style>

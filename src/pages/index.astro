---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedPost from "../components/posts/FeaturedPost.astro";
import LoadMore from "../components/posts/LoadMore.astro";
import PostList from "../components/posts/PostList.astro";
import { SITE } from "../config/site";
import { getFeaturedPost, getPublishedPosts, getReadingTimes } from "../lib/posts";

const PAGE_SIZE = 6;
const posts = await getPublishedPosts();
const minutes = await getReadingTimes(posts);
const featured = getFeaturedPost(posts);
const rest = posts.filter((post) => post.id !== featured?.id);
const firstPage = rest.slice(0, PAGE_SIZE);
const heldBack = rest.slice(PAGE_SIZE);
---

{
  /* The profile links belong to the introduction here, so the footer's own
     copy of them is switched off. */
}
<BaseLayout socials={false}>
  <div class="home">
    <header class="hero">
      <h1 class="page-title title" data-enter>Hello World!</h1>
      <p class="page-tagline" data-enter style="--enter-stage: 1">{SITE.description}</p>
      {
        SITE.greeting && (
          <p class="dek" data-enter style="--enter-stage: 2">
            {SITE.greeting}
          </p>
        )
      }
      <ul class="profile" role="list" aria-label="Elsewhere" data-pagefind-ignore>
        {
          SITE.socials.map((social) => (
            <li>
              <a href={social.href} rel="me noopener">
                {social.label}
                <span aria-hidden="true"> ↗</span>
              </a>
            </li>
          ))
        }
        <li><a href="/rss.xml">RSS<span aria-hidden="true"> ↗</span></a></li>
      </ul>
    </header>

    <div class="index">
      {featured && <FeaturedPost post={featured} minutes={minutes.get(featured.id)} />}

      <PostList posts={firstPage} minutes={minutes} id="home-posts" />
      <LoadMore rest={heldBack} minutes={minutes} listId="home-posts" />
    </div>
  </div>
</BaseLayout>

<style>
  /* One centred column: home is an introduction and a reading list, not the
     archive's filter view, so it has no topic tabs and no side column. */
  .home {
    margin-inline: auto;
    max-inline-size: 45rem;
  }

  .hero {
    margin-block: var(--space-8) var(--space-10);
  }

  /* Kept verbatim, so not lowercased like the other page titles. */
  .title {
    text-transform: none;
  }

  .dek {
    color: var(--color-ink-2);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    margin-block-start: var(--space-5);
  }

  .profile {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-block-start: var(--space-5);
  }

  .profile a {
    color: var(--color-ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-decoration: none;
    text-transform: uppercase;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .profile a:hover {
    color: var(--color-ink);
  }

  .index {
    display: grid;
    gap: var(--space-6);
  }
</style>

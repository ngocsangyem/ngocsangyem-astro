---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRows from '../components/posts/PostRows.astro';
import { SITE } from '../config/site';
import { getPublishedPosts } from '../lib/posts';

const RECENT_COUNT = 6;
const posts = await getPublishedPosts();
const recent = posts.slice(0, RECENT_COUNT);
const hasMore = posts.length > recent.length;
---

<BaseLayout>
  {/* Rows carry their own stagger, so the wrapper must not add a second one. */}
  <div class="prose-column">
    <h1 data-enter>Hello World!</h1>
    {SITE.greeting && <p class="greeting" data-enter style="--enter-stage: 1">{SITE.greeting}</p>}

    <section data-enter style="--enter-stage: 2">
      <h2 class="heading">Recent</h2>
      <PostRows posts={recent} />
      {hasMore && (
        <p class="more">
          <a href="/posts">All posts</a>
        </p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  h1 {
    font-size: 1.875rem;
    letter-spacing: -0.015em;
    margin-block: 1.5rem 0;
  }

  .greeting {
    color: var(--color-ink);
    font-size: 1.0625rem;
    line-height: 1.75;
    margin-block: 1rem 3.5rem;
    max-width: 52ch;
  }

  .heading {
    color: var(--color-ink-light);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    margin-block-end: var(--space-3);
    text-transform: uppercase;
  }

  .more {
    color: var(--color-ink-light);
    font-size: 0.9375rem;
    margin-block-start: var(--space-5);
  }
</style>
